mixin section-benefits()
  section.section.section-benefits#section-benefits
    .wrap__inner
      .align-center
        h2.heading2(data-aos="fade-up" data-aos-duration="1500") 帳戶
          span.fc-brown 優惠

      .titlePanel
        .titlePanel--title 手續費優惠禮
        .titlePanel--wrap
          .titlePanel--img
            img(src=root+'images/img-benefits.svg' alt="")
          .titlePanel--content
            h4 歡迎加入退休信託帳戶可攜服務
            p 即日起至 2024年12月31日符合資格者享終生手續費優惠！
            hr
            p 自他行攜入受益憑證至永豐銀行，並於永豐銀行設定持續定時(不)定額扣款成功者，享新臺幣10,000 (含)元以下
            .reminder 「退休可攜基金」定時(不)定額申購
              span.text-large 0
              | 元起，手續費終生優惠！
            div
              a.btn-round.btn-round--arrow.l-open(href="#TermsPromotion") 優惠方案注意事項

    .section-benefits__decobox
      .section-benefits__plant.hidden-min
        img(src=root+'images/img-bg-plant.svg' alt="")
      .section-benefits__sofa.hidden-min
        img(src=root+'images/img-bg-sofa.svg' alt="")
