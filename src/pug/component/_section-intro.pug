mixin section-intro()
  section.section.section-intro#section-intro
    .wrap__inner
      .subtitle-card__row
        .subtitle-card__col
          .subtitle-card__card-inner.animated.fadeIn
            img.subtitle-card__card-title(src=root+'images/img-subtitleCard-title-1.svg' alt="")
            .subtitle-card__desc.animated.fadeIn.delay-1s
              .subtitle-card__desc-title 800
              img.subtitle-card__desc-img(src=root+'images/img-subtitleCard-sub-1.svg' alt="")
        .subtitle-card__col
          .subtitle-card__card-inner.animated.fadeIn
            img.subtitle-card__card-title(src=root+'images/img-subtitleCard-title-2.svg' alt="")
            .subtitle-card__desc.animated.fadeIn.delay-1s
              .subtitle-card__desc-title 0
              img.subtitle-card__desc-img(src=root+'images/img-subtitleCard-sub-2.svg' alt="")
        .subtitle-card__col
          .subtitle-card__card-inner.animated.fadeIn
            img.subtitle-card__card-title(src=root+'images/img-subtitleCard-title-3.svg?v=0630' alt="")
            .subtitle-card__desc.animated.fadeIn.delay-1s
              .subtitle-card__desc-title 0.01
              img.subtitle-card__desc-img(src=root+'images/img-subtitleCard-sub-3.svg' alt="")
        .subtitle-card__col
          .subtitle-card__card-inner.animated.fadeIn
            img.subtitle-card__card-title(src=root+'images/img-subtitleCard-title-4.svg' alt="")
            .subtitle-card__desc.animated.fadeIn.delay-1s
              .subtitle-card__desc-title 7
              img.subtitle-card__desc-img(src=root+'images/img-subtitleCard-sub-4.svg' alt="")